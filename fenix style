/* =========================================================
   RESET
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f8f9fa;
    color: #261d2b;
    overflow-x: hidden;
}


/* =========================================================
   MENU
========================================================= */

.topnav {

    height: 110px;
    width: 100%;

    background: #c9a0dc;

    display: flex;
    align-items: center;

    position: sticky;
    top: 0;

    z-index: 1000;

    padding: 0;

    border-bottom: 1px solid rgba(147,180,215,0.25);

}


.logo-container {

    position: absolute;
    height: auto;
    left: 10px;
    top: 50%; 
    transform: translateY(-50%);

}


.logo {

    width: 300px;
    height: auto;
    display: block;

}


.menu-links {

    margin-left: auto;

    display: flex;

    align-items: center;

    gap: 5px;

    list-style: none;

}


.menu-links a {

    color: white;

    text-decoration: none;

    font-size: 20px;

    padding: 9px 17px;

    border-radius: 30px;

    transition: 0.3s;

}


.menu-links a:hover {

    background: #c9a0dc

}


.menu-toggle {

    display: none;

    margin-left: auto;

    background: none;

    border: none;

    color: white;

    font-size: 28px;

    cursor: pointer;

}


/* =========================================================
   HERO
========================================================= */

.hero {

    min-height: 650px;

    position: relative;

    overflow: hidden;

    background: #48204a;

    color: white;

    display: flex;

    align-items: center;

    justify-content: center;

}


.hero-texto {

    position: relative;

    z-index: 5;

    width: 90%;

    max-width: 1200px;

    text-align: center;

}


.hero-mini {

    display: block;

    color:#c9a0dc;

    font-size: 20px;

    letter-spacing: 7px;

    margin-bottom: 15px;

}


.hero h1 {

    font-size: clamp(70px, 12vw, 170px);

    line-height: 0.8;

    letter-spacing: -7px;

    font-weight: 900;

    color: white;

}


.hero h2 {

    font-size: clamp(50px, 8vw, 110px);

    line-height: 1;

    font-weight: 300;

    letter-spacing: 4px;

    -webkit-text-stroke: 2px #c9a0dc;

    margin-top: 30px;
}


.hero p {

    max-width: 550px;

    margin: 30px auto;

    color: #d4d4d4;

    font-size: 18px;

}


.hero-btn {

    display: inline-block;

    background: #702582;

    color: #d5c6dc;

    padding: 13px 25px;

    border-radius: 25px;

    text-decoration: none;

    font-size: 18px;

    font-weight: bold;

    transition: 0.3s;

}


.hero-btn:hover {

    background: #c9a0dc;

    color: white;

}




/* =========================================================
   DECORAÇÃO HERO
========================================================= */

.linha-decorativa {

    position: absolute;

    border: 1px solid rgba(147,180,215,0.2);

    transform: rotate(-25deg);

}


.linha-1 {

    width: 600px;
    height: 600px;

    left: -300px;
    top: -250px;

}


.linha-2 {

    width: 700px;
    height: 700px;

    right: -350px;
    bottom: -300px;

}


.circulo-decorativo {

    position: absolute;

    border: 1px solid rgba(147,180,215,0.15);

    border-radius: 50%;

}


.circulo-1 {

    width: 550px;
    height: 550px;

    left: -280px;
    top: 40px;

}


.circulo-2 {

    width: 500px;
    height: 500px;

    right: -250px;
    top: -150px;

}

/* ==================================================
   DEPOIMENTOS
================================================== */

.depoimentos {
    width: 100%;
    min-height: 650px;

    padding: 80px 20px;

    background: #f8f9fa;

    display: flex;
    flex-direction: column;
    align-items: center;
}


/* ==================================================
   TÍTULO
================================================== */

.titulo-depoimentos {
    margin-bottom: 60px;

    font-size: clamp(35px, 5vw, 65px);

    color: #48204a;

    text-align: center;
}


/* ==================================================
   ÁREA DO CARD
================================================== */

.depoimento-wrapper {
    position: relative;

    width: 620px;
    max-width: 90%;

    min-height: 430px;
}


/* ==================================================
   FORMAS ROXAS ATRÁS
================================================== */

.decoracao {
    position: absolute;

    border: 3px solid #8d4bbb;

    border-radius: 35px;

    pointer-events: none;
}


/* FORMA 1 */

.decoracao-1 {
    width: 90%;
    height: 90%;

    top: -20px;
    left: 25px;

    transform: rotate(-2deg);
}


/* FORMA 2 */

.decoracao-2 {
    width: 94%;
    height: 94%;

    top: 15px;
    left: -15px;

    transform: rotate(2deg);
}


/* FORMA 3 */

.decoracao-3 {
    width: 88%;
    height: 92%;

    top: 5px;
    right: -15px;

    transform: rotate(-1deg);
}


/* ==================================================
   CARD PRINCIPAL
================================================== */

.depoimento-card {
    position: relative;

    z-index: 5;

    width: 100%;
    min-height: 430px;

    padding: 45px 70px 45px 100px;

    background: #fff7ff;

    border-radius: 30px;

    box-shadow:
        0 15px 35px rgba(72, 32, 74, 0.15);

    overflow: visible;
}


/* ==================================================
   BORDA PONTILHADA
================================================== */

.depoimento-card::before {
    content: "";

    position: absolute;

    inset: 15px;

    border: 1px dashed #c9a0dc;

    border-radius: 22px;

    pointer-events: none;
}


/* ==================================================
   CONTEÚDO
================================================== */

.depoimento-conteudo {
    position: relative;

    z-index: 3;
}


/* ==================================================
   NOME
================================================== */

.depoimento-conteudo h3 {
    margin-bottom: 8px;

    font-family: Georgia, serif;

    font-size: 36px;

    font-weight: 400;

    color: #261d2b;
}


/* ==================================================
   IDADE
================================================== */

.idade {
    margin-bottom: 25px;

    font-size: 18px;

    color: #6d6470;
}


/* ==================================================
   TEXTO
================================================== */

#depoimento-texto {
    max-width: 420px;

    margin-bottom: 35px;

    font-size: 16px;

    line-height: 1.7;

    color: #3b3340;

    text-align: justify;
}


/* ==================================================
   ANIMAÇÃO TRIANGULAR
================================================== */

.depoimento-card.animando {
    animation:
        animacaoTriangular 0.6s ease;
}


@keyframes animacaoTriangular {

    0% {
        clip-path:
            polygon(
                0 0,
                0 0,
                0 100%
            );
    }

    50% {
        clip-path:
            polygon(
                0 0,
                100% 0,
                0 100%
            );
    }

    100% {
        clip-path:
            polygon(
                0 0,
                100% 0,
                100% 100%,
                0 100%
            );
    }

}


/* ==================================================
   BOLINHAS
================================================== */

.bolinha {
    position: absolute;

    z-index: 10;

    width: 18px;
    height: 18px;

    border-radius: 50%;

    background: #8d4bbb;
}


.bolinha-1 {
    top: 65px;
    right: 55px;
}


.bolinha-2 {
    bottom: 35px;
    right: 100px;

    width: 13px;
    height: 13px;

    background: #c9a0dc;
}


/* ==================================================
   SETAS
================================================== */

/* ==================================================
   SETAS DO DEPOIMENTO
================================================== */

.depoimento-seta {
    position: absolute;

    top: 50%;

    transform: translateY(-50%);

    z-index: 30;

    width: 52px;
    height: 52px;

    border: 3px solid #8d4bbb;

    border-radius: 50%;

    background: #ffffff;

    color: #8d4bbb;

    font-size: 36px;
    font-weight: 400;

    cursor: pointer;

    display: flex;
    align-items: center;
    justify-content: center;

    box-shadow:
        0 8px 20px rgba(72, 32, 74, 0.18);

    transition:
        transform 0.25s ease,
        background 0.25s ease,
        color 0.25s ease,
        box-shadow 0.25s ease;
}


/* SETA ESQUERDA */

.seta-esquerda {
    left: -65px;
}

.seta-direita {
    right: -65px;
}


/* EFEITO AO PASSAR O MOUSE */

.depoimento-seta:hover {

    background: #8d4bbb;

    color: white;

    transform:
        translateY(-50%)
        scale(1.12);

    box-shadow:
        0 12px 25px rgba(72, 32, 74, 0.28);
}


/* EFEITO AO CLICAR */

.depoimento-seta:active {

    transform:
        translateY(-50%)
        scale(0.92);

}

/* ==================================================
   RESPONSIVO
================================================== */

@media (max-width: 700px) {

    .depoimentos {
        padding: 60px 15px;
    }


    .depoimento-wrapper {
        width: 100%;
        max-width: 520px;
    }


    .depoimento-card {
        min-height: 400px;

        padding: 45px 55px;
    }


    .depoimento-conteudo h3 {
        font-size: 30px;
    }


    #depoimento-texto {
        font-size: 15px;

        max-width: 100%;
    }

    .seta-esquerda {
        left: -25px;
    }

    .seta-direita {
        right: -25px;
    }
}


@media (max-width: 450px) {

    .depoimentos {
        padding-left: 10px;
        padding-right: 10px;
    }


    .depoimento-card {
        min-height: 420px;

        padding: 40px 35px;
    }


    .depoimento-card::before {
        inset: 10px;
    }


    .depoimento-conteudo h3 {
        font-size: 28px;
    }


    .idade {
        font-size: 16px;
    }


    #depoimento-texto {
        font-size: 14px;

        line-height: 1.6;
    }


    .depoimento-seta {
        width: 42px;
        height: 42px;

        font-size: 28px;
    }

}


/* CARROSSEL */

.carrossel {

    position: relative;

    width: 100%;

    max-width: 1200px;

    height: 500px;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: center;

}


.cards-container {

    position: relative;

    width: 100%;

    height: 100%;

    display: flex;

    align-items: center;

    justify-content: center;

}


/* CARD */

.card {

    position: absolute;

    width: 380px;

    height: 420px;

    padding: 40px;

    border-radius: 30px;

    background:#c9a0dc;

    color: #48204a;

    opacity: 0;

    pointer-events: none;

    transform: scale(.7);

    z-index: 1;

    display: flex;

    flex-direction: column;

    box-shadow: 0 15px 40px rgba(0,0,0,.08);

    transition: .6s cubic-bezier(.25,1,.5,1);

    overflow: hidden;

}


.card.left,
.card.right {

    opacity: 1;

    transform: scale(.84);

    z-index: 2;

    filter: brightness(.94);

}


.card.left {

    transform: translateX(-390px) scale(.84);

}


.card.right {

    transform: translateX(390px) scale(.84);

}


.card.active {

    opacity: 1;

    transform: translateX(0) scale(1);

    z-index: 5;

    pointer-events: auto;

    background: var(--azul);

    color: white;

    filter: none;

    box-shadow: 0 25px 60px rgba(15,76,130,.3);

}


/* TOPO DO CARD */

.card-top {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 15px;

}


.nome {

    width: 100%;

    min-height: 32px;

    font-size: 23px;

    font-weight: bold;

    line-height: 1.3;

    outline: none;

    border-radius: 6px;

}


/* TEXTO */

.texto {

    flex: 1;

    margin-top: 35px;

    font-size: 19px;

    line-height: 1.8;

    overflow-y: auto;

    outline: none;

    padding: 5px 8px 5px 0;

    border-radius: 6px;

}


.texto::-webkit-scrollbar {

    width: 5px;

}


.texto::-webkit-scrollbar-thumb {

    background: rgba(255,255,255,.35);

    border-radius: 20px;

}


[contenteditable]:focus {

    outline: 2px dashed rgba(255,255,255,.65);

    outline-offset: 6px;

}


.card:not(.active) [contenteditable]:focus {

    outline-color: rgba(0,0,0,.25);

}


/* EXCLUIR */

.excluir-card {

    width: 36px;

    height: 36px;

    flex-shrink: 0;

    border: 0;

    border-radius: 50%;

    background: rgba(255,255,255,.15);

    color: white;

    font-size: 17px;

    cursor: pointer;

    opacity: 0;

    transition: .2s;

}


.card.active .excluir-card {

    opacity: 1;

}


.excluir-card:hover {

    background: #e74c3c;

    transform: scale(1.08);

}


/* SETAS */

.nav {

    position: absolute;

    top: 50%;

    width: 52px;

    height: 52px;

    border: 0;

    border-radius: 50%;

    background: white;

    color: var(--azul);

    font-size: 23px;

    display: flex;

    align-items: center;

    justify-content: center;

    cursor: pointer;

    z-index: 20;

    box-shadow: 0 8px 25px rgba(0,0,0,.13);

    transform: translateY(-50%);

    transition: .25s;

}


.nav:hover {

    background: var(--azul);

    color: white;

    transform: translateY(-50%) scale(1.1);

}


.voltar {

    left: 5px;

}


.passar {

    right: 5px;

}


/* STATUS */

.status-carrossel {

    position: absolute;

    bottom: 0;

    left: 50%;

    transform: translateX(-50%);

    font-size: 12px;

    color: #7b8995;

    opacity: 0;

    transition: .3s;

}


.status-carrossel.mostrar {

    opacity: 1;

}


/* BOLINHAS */

.dots {

    display: flex;

    justify-content: center;

    gap: 9px;

    margin-top: 25px;

}


.dot {

    width: 9px;

    height: 9px;

    border: 0;

    border-radius: 50%;

    background: #ccd5dd;

    cursor: pointer;

    transition: .3s;

}


.dot.active {

    width: 28px;

    border-radius: 20px;

    background: var(--azul);

}


/* BOTÃO ADICIONAR */

.acoes {

    display: flex;

    justify-content: center;

    margin-top: 35px;

}


.adicionar {

    border: 0;

    padding: 15px 28px;

    border-radius: 30px;

    background: var(--azul);

    color: white;

    font-size: 16px;

    font-weight: bold;

    cursor: pointer;

    display: flex;

    align-items: center;

    gap: 8px;

    box-shadow: 0 10px 25px rgba(15,76,130,.22);

    transition: .25s;

}


.adicionar:hover {

    background: #0b3c67;

    transform: translateY(-3px);

}


.salvamento {

    text-align: center;

    margin-top: 14px;

    color: #7b8995;

    font-size: 13px;

    opacity: 0;

    transition: .3s;

}


.salvamento.mostrar {

    opacity: 1;

}


/* =========================================================
   TÍTULOS
========================================================= */

.titulo-bloco {

    text-align: center;

    margin-bottom: 55px;

}


.titulo-bloco span {

    display: block;

    color: var(--azul);

    font-size: 12px;

    letter-spacing: 5px;

    margin-bottom: 10px;

}


.titulo-bloco h2 {

    font-size: clamp(38px, 6vw, 70px);

    text-transform: uppercase;

    line-height: .95;

    letter-spacing: -3px;

    color: #48204a;

}


.titulo-branco h2 {

    color: #48204a;

}


.titulo-branco span {

    color: #c9a0dc;

}


/* =========================================================
   SOBRE
========================================================= */

.sobre {

    position: relative;

    background: white;

    padding: 100px 7% 120px;

}


.sobre-conteudo {

    max-width: 1200px;

    margin: 0 auto;

    display: grid;

    grid-template-columns: 1.2fr .8fr;

    align-items: center;

    gap: 60px;

}


.sobre-caixa {

    background: #f3f5f7;

    border: 1px solid #ddd;

    border-left: 7px solid #702582;

    padding: 20px;

    box-shadow: 12px 12px 0 #702582 ;

}


.sobre-caixa h3 {

    color: #702582;

    font-size: 45px;

    margin-bottom: 25px;

}


.sobre-caixa p {

    color: #666;

    font-size: 20px;

    line-height: 1.8;

    margin-bottom: 15px;

}


.sobre-imagem {

    height: 500px;

    display: flex;

    align-items: center;

    justify-content: center;

    overflow: hidden;

}


.sobre-imagem img {

    width: 100%;

    height: 100%;

    object-fit: contain;

    filter: drop-shadow(0 15px 15px rgba(0,0,0,.25));

}
