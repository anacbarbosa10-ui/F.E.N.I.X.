/* =========================================================
   FAIXA
========================================================= */

.faixa {

    width: 110%;

    margin-left: -5%;

    height: 75px;

    background: #c9a0dc;

    transform: rotate(-3deg);

    position: relative;

    z-index: 5;

    display: flex;

    align-items: center;

    overflow: hidden;

    box-shadow: 0 5px 0 #702582;

}


.faixa-conteudo {

    width: max-content;

    display: flex;

    align-items: center;

    gap: 35px;

    color: #17191c;

    font-size: 13px;

    font-weight: bold;

    letter-spacing: 2px;

    animation: passar 20s linear infinite;

}


@keyframes passar {

    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(-50%);
    }

}


/* =========================================================
   PROJETOS
========================================================= */


.projetos {
    position: relative;

    background: 48204a;

    padding: 120px 7% 100px;

    color: #48204a;

    overflow: hidden;
}


/* SUBTÍTULO */

.subtitulo-projetos {
    text-align: center;

    color: #702582;

    margin-top: -20px;

    margin-bottom: 45px;

    font-size: 20px;

    line-height: 1.6;
}


/* =========================================================
   ÁREA DO CARROSSEL
========================================================= */

.livros-carousel {
    position: relative;

    width: 100%;

    max-width: 1250px;

    height: 590px;

    margin: 0 auto;

    display: flex;

    align-items: center;

    justify-content: center;
}


/* =========================================================
   CONTAINER DOS CARDS
========================================================= */

.livros-container {
    position: relative;

    width: 100%;

    height: 100%;

    display: flex;

    align-items: center;

    justify-content: center;
}


/* =========================================================
   CARD
========================================================= */

.livro-card {

    position: absolute;

    width: 850px;

    height: 500px;

    background: #ffffff;

    color: #c9a0dc;

    border-radius: 28px;

    padding: 32px;

    display: flex;

    flex-direction: column;

    opacity: 0;

    transform:
        translateX(0)
        scale(.7);

    transition:
        all .6s cubic-bezier(.25, 1, .5, 1);

    z-index: 1;

    pointer-events: none;

    box-shadow:
        0 10px 30px rgba(0,0,0,.08);
}


/* =========================================================
   TÍTULO DO LIVRO
========================================================= */

.livro-card h3 {

    margin: 0 0 25px;

    font-size: 30px;

    line-height: 1.2;

    color: #333;

}


/* =========================================================
   LIVRO À ESQUERDA
========================================================= */

.livro-card.livro-left {

    opacity: .45;

    transform:
        translateX(-390px)
        scale(.85);

    z-index: 2;

    filter: grayscale(.5);

}


/* =========================================================
   LIVRO À DIREITA
========================================================= */

.livro-card.livro-right {

    opacity: .45;

    transform:
        translateX(390px)
        scale(.85);

    z-index: 2;

    filter: grayscale(.5);

}


/* =========================================================
   LIVRO CENTRAL
========================================================= */

.livro-card.livro-active {

    opacity: 1;

    transform:
        translateX(0)
        scale(1);

    z-index: 10;

    pointer-events: auto;

    filter: none;

    background: #c9a0dc;

    color: white;

    box-shadow:
        #d5c6dc;

}


/* TÍTULO DO CARD CENTRAL */

.livro-card.livro-active h3 {

    color: white;

}


/* =========================================================
   IMAGEM + INFORMAÇÕES
========================================================= */

.livro-conteudo {

    display: flex;

    align-items: center;

    gap: 40px;

    flex: 1;

    min-height: 0;
}


/* =========================================================
   IMAGEM DO LIVRO
========================================================= */

.livro-conteudo img {

    width: 250px;

    height: 350px;

    object-fit: cover;

    flex-shrink: 0;

    border-radius: 8px;

    box-shadow:
        0 8px 20px rgba(0,0,0,.18);

}


/* =========================================================
   INFORMAÇÕES
========================================================= */

.livro-informacoes {

    flex: 1;

    height: 350px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

}


/* TEXTO */

.livro-informacoes p {

    margin: 0;

    font-size: 18px;

    line-height: 1.65;

    color: #444;

}


/* TEXTO DO CARD ATIVO */

.livro-card.livro-active
.livro-informacoes p {

    color: white;

}


/* =========================================================
   BOTÃO LEIA AQUI
========================================================= */

.livro-leia {

    display: inline-block;

    width: fit-content;

    padding: 11px 22px;

    background: white;

    color: #48204a;

    text-decoration: none;

    border-radius: 6px;

    font-weight: bold;

    transition: .3s;

}


.livro-leia:hover {

    transform: scale(1.05);

}

/* =========================================================
   SETAS DO CARROSSEL
========================================================= */
/* =========================================
   SETAS DOS LIVROS
========================================= */

.livro-prev,
.livro-next {

    position: absolute;

    top: 50%;

    width: 45px;
    height: 45px;

    transform: translateY(-50%);

    border: none;
    border-radius: 50%;

    background: #815c97;
    color: white;

    font-size: 24px;

    display: flex;
    align-items: center;
    justify-content: center;

    cursor: pointer;

    z-index: 50;

}


/* SETA ESQUERDA */

.livro-prev {
    left: 10%;
}


/* SETA DIREITA */

.livro-next {
    right: 10%;
}


/* EFEITO AO PASSAR O MOUSE */

.livro-prev:hover,
.livro-next:hover {

    transform: translateY(-50%) scale(1.08);

}

/* =========================================================
   BOLINHAS
========================================================= */

.livros-dots {

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 10px;

    margin-top: 15px;

}


.livro-dot {

    width: 10px;

    height: 10px;

    padding: 0;

    border: none;

    border-radius: 50%;

    background: #815c97;

    cursor: pointer;

    transition: .3s;

}


.livro-dot.active {

    width: 26px;

    border-radius: 12px;

    background: #815c97;

}


