        /* =========================================
   CARROSSEL DO HERO
========================================= */

.hero-texto {
    position: relative;
    width: 90%;
    max-width: 1200px;
    text-align: center;
    z-index: 10;
    min-height: 350px;
}

.hero-slide {
    display: none;
    animation: aparecerHero 0.5s ease;
}

.hero-slide.ativo {
    display: block;
}

@keyframes aparecerHero {

    from {
        opacity: 0;
        transform: translateX(40px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

}


/* =========================================
   SETAS
========================================= */

.hero-seta {
    position: absolute;

    top: 50%;
    transform: translateY(-50%);

    width: 55px;
    height: 55px;

    border: none;
    border-radius: 50%;

    background: white;
    color: #48204a;

    font-size: 40px;
    line-height: 1;

    cursor: pointer;

    z-index: 20;

    transition: 0.3s;
   
}

.hero-seta:hover {
    background:#c9a0dc;
    color: white;
    transform: translateY(-50%) scale(1.1);
}

.hero-anterior {
    left: -100px;
    right: auto ;
}

.hero-proximo {
    right: -100px ;
    left: auto;
}
/* =========================================
   INDICADORES
========================================= */

.hero-indicadores {
    position: absolute;

    bottom: -40px;

    left: 50%;
    transform: translateX(-50%);

    display: flex;
    gap: 10px;

    z-index: 20;
}

.hero-indicador {
    width: 12px;
    height: 12px;

    border: none;
    border-radius: 50%;

    background: white;

    cursor: pointer;

    transition: 0.3s;
}

.hero-indicador.ativo {
    width: 30px;
    border-radius: 20px;
    background: #c9a0dc;
}


/* =========================================
   CELULAR
========================================= */

@media (max-width: 768px) {

    .hero-texto {
        width: 90%;
        min-height: 400px;
