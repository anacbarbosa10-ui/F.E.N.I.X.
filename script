// COMENTÁRIOS - F.E.N.I.X
// =========================================================

const comentariosFenix = [
    "Adorei a atenção deles, me senti acolhida.",
    "Amei o trabalho deles."
];

let indiceComentarioFenix = 0;


// =========================================================
// MOSTRAR COMENTÁRIO
// =========================================================

function mostrarComentarioFenix() {

    const comentario =
        document.getElementById("comentario");

    if (!comentario) {
        return;
    }

    if (comentariosFenix.length === 0) {
        comentario.textContent =
            "Ainda não há comentários.";
        return;
    }

    comentario.textContent =
        comentariosFenix[indiceComentarioFenix];
}


// =========================================================
// PRÓXIMO
// =========================================================

function comentarioFenixProximo() {

    if (comentariosFenix.length === 0) {
        return;
    }

    indiceComentarioFenix++;

    if (
        indiceComentarioFenix >=
        comentariosFenix.length
    ) {
        indiceComentarioFenix = 0;
    }

    mostrarComentarioFenix();
}


// =========================================================
// ANTERIOR
// =========================================================

function comentarioFenixAnterior() {

    if (comentariosFenix.length === 0) {
        return;
    }

    indiceComentarioFenix--;

    if (indiceComentarioFenix < 0) {
        indiceComentarioFenix =
            comentariosFenix.length - 1;
    }

    mostrarComentarioFenix();
}


// =========================================================
// ADICIONAR COMENTÁRIO
// =========================================================

function adicionarComentarioFenix() {

    const campo =
        document.getElementById("novoComentario");

    if (!campo) {
        return;
    }

    const texto = campo.value.trim();

    if (texto === "") {
        alert("Digite um comentário.");
        return;
    }

    // Adiciona o novo comentário
    comentariosFenix.push(texto);

    // Vai direto para o comentário recém-adicionado
    indiceComentarioFenix =
        comentariosFenix.length - 1;

    // Mostra o novo comentário
    mostrarComentarioFenix();

    // Limpa a caixa
    campo.value = "";

    alert("Comentário adicionado com sucesso!");
}



// =========================================================
// INICIAR
// =========================================================

mostrarComentarioFenix();

