let heroSlideAtual = 0;

const heroSlides =
    document.querySelectorAll(".hero-slide");

const heroIndicadores =
    document.querySelectorAll(".hero-indicador");


function atualizarHero() {

    heroSlides.forEach((slide, index) => {

        slide.classList.toggle(
            "ativo",
            index === heroSlideAtual
        );

    });


    heroIndicadores.forEach((indicador, index) => {

        indicador.classList.toggle(
            "ativo",
            index === heroSlideAtual
        );

    });

}


function heroProximo() {

    heroSlideAtual++;

    if (heroSlideAtual >= heroSlides.length) {
        heroSlideAtual = 0;
    }

    atualizarHero();

}


function heroAnterior() {

    heroSlideAtual--;

    if (heroSlideAtual < 0) {
        heroSlideAtual = heroSlides.length - 1;
    }

    atualizarHero();

}


function heroIrPara(numero) {

    heroSlideAtual = numero;

    atualizarHero();

}

