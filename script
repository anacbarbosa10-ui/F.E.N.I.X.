const btnVoltarTopo =
    document.getElementById("btnVoltarTopo");


window.addEventListener(
    "scroll",
    () => {

        if (!btnVoltarTopo) {
            return;
        }


        if (
            document.body.scrollTop > 200 ||
            document.documentElement.scrollTop > 200
        ) {

            btnVoltarTopo.style.display =
                "block";

        } else {

            btnVoltarTopo.style.display =
                "none";

        }

    }
);


if (btnVoltarTopo) {

    btnVoltarTopo.addEventListener(
        "click",
        () => {

            window.scrollTo({

                top: 0,

                behavior: "smooth"

            });

        }
    );

}





// =========================================
// 6. CARROSSEL DE LIVROS
// =========================================

const livrosCards =
    document.querySelectorAll(".livro-card");

const livrosNext =
    document.querySelector(".livro-next");

const livrosPrev =
    document.querySelector(".livro-prev");

const livrosDots =
    document.getElementById("livrosDots");


let livroAtual = 0;
let livrosTimer = null;

const LIVROS_INTERVALO = 4000;


// =========================================
// CRIAR BOLINHAS
// =========================================

if (
    livrosCards.length &&
    livrosDots
) {

    livrosCards.forEach((_, indice) => {

        const dot =
            document.createElement("button");

        dot.type = "button";

        dot.className = "livro-dot";

        dot.setAttribute(
            "aria-label",
            `Ir para o livro ${indice + 1}`
        );


        dot.addEventListener(
            "click",
            () => {

                livroAtual = indice;

                atualizarLivros();

                reiniciarLivros();

            }
        );


        livrosDots.appendChild(dot);

    });

}


// =========================================
// ATUALIZAR LIVROS
// =========================================

function atualizarLivros() {

    if (!livrosCards.length) {
        return;
    }


    const livroBolinhas =
        document.querySelectorAll(".livro-dot");


    livrosCards.forEach(card => {

        card.classList.remove(
            "livro-active",
            "livro-left",
            "livro-right"
        );

    });


    livroBolinhas.forEach(dot => {

        dot.classList.remove("active");

    });


    const esquerda =
        (
            livroAtual -
            1 +
            livrosCards.length
        ) %
        livrosCards.length;


    const direita =
        (
            livroAtual +
            1
        ) %
        livrosCards.length;


    livrosCards[livroAtual]
        .classList.add("livro-active");


    if (livrosCards.length > 1) {

        livrosCards[esquerda]
            .classList.add("livro-left");


        livrosCards[direita]
            .classList.add("livro-right");

    }


    if (livroBolinhas[livroAtual]) {

        livroBolinhas[livroAtual]
            .classList.add("active");

    }

}


// =========================================
// PRÓXIMO LIVRO
// =========================================

function proximoLivro() {

    if (livrosCards.length <= 1) {
        return;
    }


    livroAtual =
        (livroAtual + 1)
        % livrosCards.length;


    atualizarLivros();

}


// =========================================
// LIVRO ANTERIOR
// =========================================

function livroAnterior() {

    if (livrosCards.length <= 1) {
        return;
    }


    livroAtual =
        (
            livroAtual -
            1 +
            livrosCards.length
        ) % livrosCards.length;


    atualizarLivros();

}


// =========================================
// INICIAR LIVROS
// =========================================

function iniciarLivros() {

    clearInterval(livrosTimer);


    if (livrosCards.length > 1) {

        livrosTimer =
            setInterval(
                proximoLivro,
                LIVROS_INTERVALO
            );

    }

}


function reiniciarLivros() {

    iniciarLivros();

}


// =========================================
// BOTÕES LIVROS
// =========================================

if (livrosNext) {

    livrosNext.addEventListener(
        "click",
        () => {

            proximoLivro();

            reiniciarLivros();

        }
    );

}


if (livrosPrev) {

    livrosPrev.addEventListener(
        "click",
        () => {

            livroAnterior();

            reiniciarLivros();

        }
    );

}


// =========================================
// TOUCH LIVROS
// =========================================

const livrosCarousel =
    document.querySelector(".livros-carousel");

let livroTouchStart = 0;


if (livrosCarousel) {

    livrosCarousel.addEventListener(
        "touchstart",
        e => {

            livroTouchStart =
                e.changedTouches[0].screenX;

        },
        {
            passive: true
        }
    );


    livrosCarousel.addEventListener(
        "touchend",
        e => {

            const livroTouchEnd =
                e.changedTouches[0].screenX;


            const distancia =
                livroTouchEnd -
                livroTouchStart;


            if (Math.abs(distancia) < 50) {
                return;
            }


            if (distancia < 0) {

                proximoLivro();

            } else {

                livroAnterior();

            }


            reiniciarLivros();

        },
        {
            passive: true
        }
    );

}


// =========================================
// INICIAR CARROSSEL DOS LIVROS
// =========================================

if (livrosCards.length) {

    atualizarLivros();

    iniciarLivros();

}

